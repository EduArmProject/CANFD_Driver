	)
	(text "SPI MAGNETIC ENCODER (AS5047P)"
		(exclude_from_sim no)
		(at 352.044 107.188 0)
		(effects
			(font
				(face "Arial")
				(size 4 4)
				(thickness 0.8)
				(bold yes)
				(color 190 0 0 1)
			)
		)
		(uuid "9a434f25-0a6b-4378-b996-224f4e5b7305")
	)
	(text "J1 / J2 : XT30PW (2+2) chaining connectors, wired in parallel\n          P = +24 V, N = GND, S1 = CAN_H, S2 = CAN_L\nTHT_J1 : SWD header for flashing and debugging (GND, V_STLINK, SWDIO, SWCLK, SWNRST)\nJ5 : 4-pin stepper motor output, coil A = OA1/OA2, coil B = OB1/OB2\nCAN termination : see SW1.4 (DIP switch)"
		(exclude_from_sim no)
		(at 289.052 39.37 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "a1ad5588-8728-4b23-b40b-72bdc0017554")
	)
	(text "3.3 V CAN-FD transceiver, up to 5 Mbit/s, driven by FDCAN1\nVIO powered at 3.3 V. STB tied to GND (normal mode)."
		(exclude_from_sim no)
		(at 304.038 179.324 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "a3c17e84-b933-42fe-8bad-19050ac55602")
	)
	(text "14-bit on-axis magnetic rotary position sensor, SPI only\nPowered at 3.3 V."
		(exclude_from_sim no)
		(at 303.784 114.046 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "be25132f-069c-48e4-8266-0f7b703195fe")
	)
	(text "4-position DIP switch (SW1)\n- SW1.1 to SW1.3 : CAN node ID, 0 to 7 \nclosed = GND = bit 0)\n- SW1.4 : 120 Ohm bus termination (R16), \nclose it on the last board of the chain only"
		(exclude_from_sim no)
		(at 151.13 52.07 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left)
		)
		(uuid "c25d706a-629d-4933-af13-f5e87195a4d8")
	)
