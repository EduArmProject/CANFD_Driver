	(text "HSE Clock: 24 MHz crystal"
		(exclude_from_sim no)
		(at 212.852 270.51 0)
		(effects
			(font
				(size 2 2)
			)
		)
		(uuid "dce47c1a-19ec-492b-bee5-a62247ac90cb")
	)
	(text "UART control (address 0): microstepping up to 1/256, run/hold current,\nStealthChop2 and SpreadCycle modes.\nSensorless homing: DIAG outputs HIGH on motor stall (StallGuard4).\nEN pulled UP: motor stays disabled at boot until the MCU drives it low.\nMS1/MS2, CLK, STDBY tied to GND. SPREAD left open (StealthChop by default)."
		(exclude_from_sim no)
		(at 21.082 166.37 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "e350a151-0b08-44d2-96ac-83d2d78036ec")
	)
	(text "Cortex-M4F, 128 KB Flash, LQFP48, FDCAN\nHSE clock : 16 MHz crystal \nSPI1 : encoder | FDCAN1 : CAN-FD \nUSART3 (half-duplex) : TMC2209 | TIM1 : STEP\nSWD on PA13/PA14. BOOT0 via SW3. \nReset button SW2 on NRST."
		(exclude_from_sim no)
		(at 238.252 110.49 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "e621cb17-7033-4164-899b-3958f379a4cb")
	)
	(text "D1 (red) : power indicator, connected directly to the +3.3 V rail\nD2 (blue) : CAN transmission activity (MCU GPIO)\nD3 (green) : initialization OK (MCU GPIO)"
		(exclude_from_sim no)
		(at 210.82 50.546 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "ef694624-534d-46f1-afe9-6884924e56b6")
	)
