	(text "Input : +24V_PROT (24 V nominal, 36 V max)\nOutput : 3.3 V, up to 1 A\nSupplies : MCU, CAN transceiver, magnetic encoder, LEDs, TMC2209 logic (VCC_IO)"
		(exclude_from_sim no)
		(at 20.828 46.482 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "6570d89c-344b-4b7d-bfcd-6b7d9885fa4e")
	)
	(text "POS 1-2 : 3.3 V from the ST-Link (programming without 24 V)\nPOS 2-3 : 3.3 V from the on-board buck (normal operation)"
		(exclude_from_sim no)
		(at 78.994 133.604 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left)
		)
		(uuid "6dbf669e-8870-4ed6-ab29-c019f1036ef1")
	)
	(text "MCU - STM32G431CBT6"
		(exclude_from_sim no)
		(at 184.912 107.696 0)
		(effects
			(font
				(face "Arial")
				(size 4 4)
				(thickness 0.8)
				(bold yes)
				(color 190 0 0 1)
			)
		)
		(uuid "7012ef58-a579-4156-8479-cc2e292b0cd9")
	)
	(text "F1 : 3A fuse, opens on short-circuit or sustained overcurrent.\nTVS1 : SMAJ26A, clamps motor and switching voltage spikes\nNo reverse-polarity protection: relies on keyed XT30 connectors."
		(exclude_from_sim no)
		(at 21.844 101.092 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left)
		)
		(uuid "7949ba19-3758-4aa3-acfc-99a9528c9369")
	)
	(text ""
		(exclude_from_sim no)
